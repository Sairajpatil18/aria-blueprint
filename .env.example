# Local dev / Vercel project settings. Never commit a real key.
# Get a free key at https://aistudio.google.com/apikey  ("Get API key")
GEMINI_API_KEY=

# Optional. Free-tier model id. Defaults to gemini-3.5-flash-lite (500 free requests/day).
# gemini-3.8-flash is newer but its free tier is only 20 requests/day.
GEMINI_MODEL=gemini-3.5-flash-lite
